[mysqld]
# Percona Server 8.4 + MyRocks -- FLAX/NVMeVirt offload (bare-metal variant).
# Same content as my-percona-myrocks-nvmevirt-sandbox.cnf; kept separate so
# logs stay unambiguous about which environment produced a run.
# __PLACEHOLDER__ tokens are substituted by mysql-control.sh at runtime from
# env-flax-baremetal.sh. basedir/plugin_dir point into the raw build tree.
user = root
port = 13308
socket = __SOCKET__
pid-file = __PID_FILE__
datadir = __DATADIR__
basedir = __BASEDIR__
plugin_dir = __PLUGIN_DIR__

# Storage Engine
default-storage-engine = ROCKSDB

# Load RocksDB Plugin
plugin-load-add = ha_rocksdb.so

# Transaction and Collation Settings (recommended for MyRocks)
transaction-isolation = READ-COMMITTED
character-set-server = latin1
collation-server = latin1_bin

# Checked at NewIterator time, not table-reader creation -- safe to toggle
# per-run via SET GLOBAL without a restart.
rocksdb_nvmevirt_enabled = ON
rocksdb_cache_index_and_filter_blocks = false

# Matches rdb_cf_options.cc's compression=kNoCompression override for
# nvmevirt_-prefixed CFs (belt and suspenders -- that override doesn't
# reliably take effect at flush time). target_file_size_base/write_buffer_size
# left at RocksDB's own defaults (64MB each) -- comfortably under the
# rocksdb_nvmevirt_max_sst_bytes offload cap (256MB default).
rocksdb_default_cf_options = compression=kNoCompression;block_based_table_factory={filter_policy=bloomfilter:10:false;whole_key_filtering=1}
rocksdb_allow_concurrent_memtable_write = ON
rocksdb_max_open_files = -1

# Level 1 = count only; profile-htap.sh bumps this for actual profiling runs.
rocksdb_perf_context_level = 1

# Binary log (ROW format for realistic production settings)
binlog_format = ROW

# Disable query logging for benchmarking
slow_query_log = 0
general_log = 0

# Disable Performance Schema
performance_schema = OFF

# Enable LOAD DATA LOCAL INFILE for bulk loading
local_infile = 1

[client]
socket = __SOCKET__
